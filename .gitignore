# env files (opt-in only for .env.example)
.env*
!.env.example

# vercel y netlify
.vercel
.netlify

# typescript
*.tsbuildinfo
next-env.d.ts

# backups y volcados de base de datos
/.backups/
/backups/
/respaldos/
*.dump
*.sql.gz
*.backup
*backup*.json
*respaldo*.json

# catalogo y datos de clientes
